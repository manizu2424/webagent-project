    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? {};\nconst submission = payload.submission ?? {};\nconst taskNames = Array.isArray(submission.repetitiveTasks) && submission.repetitiveTasks.length > 0\n  ? submission.repetitiveTasks.slice(0, 3)\n  : ['반복 업무 정리'];\nconst dailyHours = Math.max(0, Math.min(24, Number(submission.dailyHours ?? 1)));\nconst toolCount = Array.isArray(submission.currentTools) ? submission.currentTools.length : 0;\nconst estimatedSavedHoursMin = Math.round(Math.min(744, dailyHours * 20 * 0.3));\nconst estimatedSavedHoursMax = Math.max(estimatedSavedHoursMin, Math.round(Math.min(744, dailyHours * 20 * 0.6)));\nconst automationScore = Math.max(0, Math.min(100, 48 + taskNames.length * 9 + toolCount * 3));\nconst recommendedTasks = taskNames.map((name, index) => ({\n  name,\n  reason: `${name} 업무는 반복 빈도와 수작업 시간을 기준으로 자동화 우선순위 ${index + 1}순위입니다.`,\n  difficulty: index === 0 ? 'LOW' : 'MEDIUM',\n  estimatedMonthlySavedHours: Math.max(1, Math.round(estimatedSavedHoursMin / taskNames.length)),\n}));\nreturn [{\n  json: {\n    diagnosisPublicId: payload.publicId,\n    automationScore,\n    recommendedTasks,\n    estimatedSavedHoursMin,\n    estimatedSavedHoursMax,\n    difficulty: recommendedTasks.some((task) => task.difficulty === 'MEDIUM') ? 'MEDIUM' : 'LOW',\n    recommendedStack: ['Next.js', 'n8n', 'PostgreSQL'],\n    implementationSteps: [\n      { order: 1, title: '업무 데이터 연결', description: '반복 업무 입력과 기존 도구의 데이터 흐름을 연결합니다.' },\n      { order: 2, title: '자동화 워크플로 구축', description: '검증 가능한 작은 단위부터 n8n 워크플로를 적용합니다.' },\n      { order: 3, title: '성과 확인', description: '처리 시간과 오류율을 측정해 자동화 범위를 조정합니다.' },\n    ],\n    aiSummary: `${submission.companyName ?? '귀사'}는 ${taskNames.join(', ')} 업무부터 자동화 가능성을 검증하는 것이 효과적입니다. 예상 절감 시간은 입력값을 기준으로 한 추정치입니다.`,\n    modelName: 'local-structured-analysis-v1',\n  },\n}];"
      },
