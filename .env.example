NODE_ENV=development

POSTGRES_DB=webagent
POSTGRES_USER=webagent_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://webagent_user:change_this_password@localhost:5432/webagent

N8N_DIAGNOSIS_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
N8N_PORT=5679
WEBAGENT_CALLBACK_URL=http://host.docker.internal:3000/api/internal/diagnosis-result
INTERNAL_API_SECRET=
AUTH_SECRET=
ADMIN_EMAIL=
# `npm run auth:hash-password`로 생성한 `$argon2id$...` 값만 사용합니다.
ADMIN_PASSWORD_HASH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 운영 프록시가 X-Real-IP를 덮어쓰고 앱 직접 접근을 차단한 경우에만 true로 설정합니다.
RATE_LIMIT_TRUST_PROXY=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
